# ─── LLM Provider ───────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Optional: override the model used by all agents (default: openai/gpt-oss-20b)
# ROUTER_MODEL=openai/gpt-oss-20b

# ─── Swiggy MCP ─────────────────────────────────────────────────────────────
# Swiggy Builders Club MCP server URLs (defaults shown — don't change unless instructed)
SWIGGY_MCP_FOOD_URL=https://mcp.swiggy.com/food
SWIGGY_MCP_INSTAMART_URL=https://mcp.swiggy.com/im
SWIGGY_MCP_DINEOUT_URL=https://mcp.swiggy.com/dineout

# OAuth redirect — must match what you registered in Swiggy Builders Club
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:7999/oauth/callback

# ─── Database (LangGraph checkpointer + order history) ──────────────────────
# PostgreSQL connection string — use Neon/Supabase free tier or a local instance
DB_URL=postgresql://user:password@localhost:5432/swiggypilot

# ─── LangSmith (optional — for tracing/debugging) ───────────────────────────
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=SwiggyPilot

# ─── Gemini (optional — NOT currently supported; see README Known Limitations) ─
# GEMINI_API_KEY=AIza...
